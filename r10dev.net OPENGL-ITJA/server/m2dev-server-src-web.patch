diff --git a/src/libthecore/socket.cpp b/src/libthecore/socket.cpp
index 1a440fb..9a782ec 100644
--- a/src/libthecore/socket.cpp
+++ b/src/libthecore/socket.cpp
@@ -3,6 +3,38 @@
 #include <netinet/tcp.h>
 #endif
 
+#ifdef __EMSCRIPTEN__
+/* All TCP goes through the in-page SharedArrayBuffer loopback (m2lb).
+ * Redirect the raw syscalls this file makes; callers outside this file
+ * only ever see the socket_* wrappers. */
+#include "m2lb.h"
+#include <arpa/inet.h>
+
+static ssize_t m2lp_recv4(socket_t d, void* b, size_t l, int f)   { (void)f; return m2lp_recv(d, b, l); }
+static ssize_t m2lp_send4(socket_t d, const void* b, size_t l, int f) { (void)f; return m2lp_send(d, b, l); }
+static ssize_t m2lp_recvfrom6(socket_t d, void* b, size_t l, int f, void* s, void* sl) { return m2lp_recvfrom(d, b, l, f, s, sl); }
+static int m2lp_socket3(int af, int type, int proto) { (void)af; (void)proto; return m2lp_socket(type); }
+static int m2lp_bind3(socket_t d, const void* sa, socklen_t l) { (void)l; return m2lp_bind(d, ntohs(((const struct sockaddr_in*)sa)->sin_port)); }
+static int m2lp_listen2(socket_t d, int b) { (void)b; return m2lp_listen(d); }
+static int m2lp_accept3(socket_t d, void* sa, socklen_t* l) { (void)l; return m2lp_accept(d, (struct sockaddr_in*)sa); }
+static int m2lp_connect3(socket_t d, const void* sa, socklen_t l) { (void)l; return m2lp_connect(d, ntohs(((const struct sockaddr_in*)sa)->sin_port)); }
+static int m2lp_setsockopt5(socket_t d, int lvl, int opt, const void* v, socklen_t l) { (void)d; (void)lvl; (void)opt; (void)v; (void)l; return 0; }
+static int m2lp_getsockopt5(socket_t d, int lvl, int opt, void* v, socklen_t* l) { (void)d; (void)lvl; (void)opt; (void)v; (void)l; return 0; }
+
+#define recv(a,b,c,d)    m2lp_recv4(a,b,c,d)
+#define send(a,b,c,d)    m2lp_send4(a,b,c,d)
+#define recvfrom(a,b,c,d,e,f) m2lp_recvfrom6(a,b,c,d,e,f)
+#define socket(a,b,c)    m2lp_socket3(a,b,c)
+#define bind(a,b,c)      m2lp_bind3(a,b,c)
+#define listen(a,b)      m2lp_listen2(a,b)
+#define accept(a,b,c)    m2lp_accept3(a,b,c)
+#define connect(a,b,c)   m2lp_connect3(a,b,c)
+#define setsockopt(a,b,c,d,e) m2lp_setsockopt5(a,b,c,d,e)
+#define getsockopt(a,b,c,d,e) m2lp_getsockopt5(a,b,c,d,e)
+#define fcntl(a,b,c)     m2lp_fcntl(a,b,c)
+#define close(a)         m2lp_close(a)
+#endif /* __EMSCRIPTEN__ */
+
 /* Forwards */
 void socket_lingeron(socket_t s);
 void socket_lingeroff(socket_t s);
@@ -247,6 +279,10 @@ socket_t socket_connect(const char* host, WORD port)
     /* 소켓주소 구조체 초기화 */
     memset(&server_addr, 0, sizeof(server_addr));
 
+#ifdef __EMSCRIPTEN__
+	/* Loopback routing is by port only; the host string is irrelevant. */
+	server_addr.sin_addr.s_addr = htonl(0x7f000001);
+#else
     if (isdigit(*host))
 	server_addr.sin_addr.s_addr = inet_addr(host);
     else
@@ -261,6 +297,7 @@ socket_t socket_connect(const char* host, WORD port)
 
 	thecore_memcpy((char* ) &server_addr.sin_addr, hp->h_addr, sizeof(server_addr.sin_addr));
     }
+#endif
 
     server_addr.sin_family = AF_INET;
     server_addr.sin_port = htons(port);
