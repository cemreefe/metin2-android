+#define send(a,b,c,d)    m2lp_send4(a,b,c,d)
+#define recvfrom(a,b,c,d,e,f) m2lp_recvfrom6(a,b,c,d,e,f)
+#define socket(a,b,c)    m2lp_socket3(a,b,c)
