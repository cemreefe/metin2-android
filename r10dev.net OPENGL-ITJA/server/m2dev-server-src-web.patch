+static int m2lp_listen2(socket_t d, int b) { (void)b; return m2lp_listen(d); }
+static int m2lp_accept3(socket_t d, void* sa, socklen_t* l) { (void)l; return m2lp_accept(d, (struct sockaddr_in*)sa); }
+static int m2lp_connect3(socket_t d, const void* sa, socklen_t l) { (void)l; return m2lp_connect(d, ntohs(((const struct sockaddr_in*)sa)->sin_port)); }
